{
  "name": "@alexcruzgargallo/ui-react",
  "author": "Alex Cruz Gargallo ",
  "version": "0.0.6",
  "type": "module",
  "main": "./dist/main.js",
  "module": "./dist/main.js",
  "types": "./dist/main.d.ts",
  "exports": {
    ".": {
      "types": "./dist/main.d.ts",
      "import": "./dist/main.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/AlexCruzGargallo/ui-react"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --p ./tsconfig-build.json && vite build && npm run generate-metadata",
    "generate-metadata": "tsx scripts/generate-metadata.ts",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^9.1.5",
    "@storybook/addon-onboarding": "^9.1.5",
    "@storybook/react-vite": "^9.1.5",
    "@types/argparse": "^2.0.17",
    "@types/node": "^20.11.30",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "eslint-plugin-storybook": "^9.1.5",
    "glob": "^10.3.10",
    "react": "^19.1.1",
    "react-docgen-typescript": "^2.4.0",
    "react-dom": "^19.1.1",
    "storybook": "^9.1.5",
    "tsx": "^4.22.4",
    "typescript": "^5.4.3",
    "vite": "^5.4.20",
    "vite-plugin-dts": "^3.7.3",
    "vite-plugin-lib-inject-css": "^2.0.1"
  }
}
